{
  "name": "kumi-code",
  "productName": "Kumi Code",
  "version": "0.1.0",
  "private": true,
  "description": "Kumi Code: a barebones Claude Code frontend",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsgo --tsconfig tsconfig.web.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "electron-vite build --mode e2e && node e2e/drag.mjs && node e2e/draft.mjs && node e2e/conversation.mjs && node e2e/restore.mjs && node e2e/delete.mjs && node e2e/rows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "diff": "^9.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "electron"
  ]
}
